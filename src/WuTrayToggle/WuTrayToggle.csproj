<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>WuTrayToggle</AssemblyName>
    <RootNamespace>WuTrayToggle</RootNamespace>
    <!-- Version / FileVersion / AssemblyVersion は Directory.Build.props の Version から導出する -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <InvariantGlobalization>true</InvariantGlobalization>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>

    <!-- インストーラー（MSI）で配るため、自己完結の複数ファイルにする（単一ファイルにしない） -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.ServiceProcess.ServiceController" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\tray-running.ico">
      <LogicalName>WuTrayToggle.Assets.tray-running.ico</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Assets\tray-stopped.ico">
      <LogicalName>WuTrayToggle.Assets.tray-stopped.ico</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>

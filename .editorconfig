root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.cs]
indent_size = 4

[*.{csproj,props,targets,wixproj,wxs,slnx,json,yml,yaml}]
indent_size = 2

[tests/**.cs]
# xUnit のテスト名は Method_Condition_Expected 形式にするため（CA1707: 名前にアンダースコア）
dotnet_diagnostic.CA1707.severity = none

<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <!-- UpgradeCode と、MainExecutable の Component の Guid は変えない（上書きアップグレードの互換性のため） -->
  <Package Name="WU Tray Toggle"
           Manufacturer="y-marui"
           Version="$(Version)"
           UpgradeCode="059381dc-b129-4c96-b6ef-9644338a7330"
           Scope="perMachine">

    <MajorUpgrade DowngradeErrorMessage="A newer version of WU Tray Toggle is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="WuTrayToggle">
        <!-- 本体の exe は、アンインストール時のカスタムアクションが FileRef で参照するため、明示的に定義する -->
        <Component Id="MainExecutable" Guid="6f1c2a3b-9e8d-4c7a-8b2e-1d4f5a6b7c8d">
          <File Id="WuTrayToggleExe" Source="$(PublishDir)\WuTrayToggle.exe" KeyPath="yes" />
        </Component>
        <!-- 残りの publish 物（自己完結のランタイム等）は丸ごと取り込む。デバッグシンボルは含めない -->
        <Files Include="$(PublishDir)\**">
          <Exclude Files="$(PublishDir)\WuTrayToggle.exe" />
          <Exclude Files="$(PublishDir)\**\*.pdb" />
        </Files>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="WU Tray Toggle">
        <Component Id="StartMenuShortcut" Guid="b2d4e6f8-1a3c-4b5d-9e7f-2c4a6b8d0e1f">
          <Shortcut Id="StartMenuShortcutFile"
                    Name="WU Tray Toggle"
                    Target="[INSTALLFOLDER]WuTrayToggle.exe"
                    WorkingDirectory="INSTALLFOLDER" />
          <RemoveFolder Id="RemoveApplicationProgramsFolder" On="uninstall" />
          <RegistryValue Root="HKCU" Key="Software\WuTrayToggle" Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="DesktopFolder">
      <Component Id="DesktopShortcut" Guid="c3e5f7a9-2b4d-4c6e-8a0f-3d5b7c9e1a2b">
        <Shortcut Id="DesktopShortcutFile"
                  Name="WU Tray Toggle"
                  Target="[INSTALLFOLDER]WuTrayToggle.exe"
                  WorkingDirectory="INSTALLFOLDER" />
        <RegistryValue Root="HKCU" Key="Software\WuTrayToggle" Name="DesktopShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <!-- The Startup-folder autostart shortcut ("ログイン時に自動起動") is created at
         runtime by the tray menu, so MSI never tracks it. Clean it up on uninstall. -->
    <CustomAction Id="DisableStartupOnUninstall"
                  FileRef="WuTrayToggleExe"
                  ExeCommand="--disable-startup"
                  Execute="deferred"
                  Return="ignore" />

    <InstallExecuteSequence>
      <Custom Action="DisableStartupOnUninstall" Before="RemoveFiles" Condition='REMOVE="ALL"' />
    </InstallExecuteSequence>
  </Package>
</Wix>
